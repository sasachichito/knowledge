@startuml
autoactivate on
Run -> Run : main
Run -> Run #FFBBBB : manageAllFiles
Run -> Run #DarkSalmon : processArgs
Run -> Run #005500 : manageFileInternal
Run -> ": SourceFileReaderAbstract" : getGeneratedImages
": SourceFileReaderAbstract" -> ": BlockUml" : getDiagram
": BlockUml" -> ": PSystemBuilder" : createPSystem

group loop ( factories ) [ createSystem isOK ]
  ": PSystemBuilder" -> ": PSystemFactory" : createSystem
  note over ": PSystemFactory"
    e.g. ClassDiagramFactory
  end note
  ": PSystemFactory" -> ": UmlSource" : iterator2
  return it : IteratorCounter2

  ": PSystemFactory" -> ": PSystemFactory" #FFBBBB : createEmptyDiagram
  ": PSystemFactory" -> ": AbstractPSystem" : new
  note over ": AbstractPSystem"
    e.g. ClassDiagram
  end note
  return AbstractPSystem
  return sys : AbstractPSystem

  group loop [ it.hasNext() ]
    ": PSystemFactory" -> ": PSystemFactory" #FFBBBB : executeFewLines(sys, ..., it , ...) 
    ": PSystemFactory" -> ": PSystemFactory" #DarkSalmon : getCandidate(it)
    ": PSystemFactory" -> ": PSystemFactory" #005500 : initCommandsList
    return
    return step : Step
    
    ": PSystemFactory" -> ": AbstractPSystem" : executeCommand(step.command, step.blocLines, ...)
    ": AbstractPSystem" -> ": ProtectedCommand" : execute
    ' ": ProtectedCommand" -> ": SingleLineCommand2" : execute
    
    ' ": SingleLineCommand2" -> ": CommandCreateClass" : executeArg(Diagram, ...)
    ' ": CommandCreateClass" -> ": CommandCreateClass" : executeArg(ClassDiagram, ...) 
    ' return CommandExecutionResult
    ' return CommandExecutionResult
    ' ": SingleLineCommand2" -> ": CommandLinkClass" : executeArg(Diagram, ...)
    ' ": CommandLinkClass" -> ": CommandLinkClass" : executeArg(AbstractClassOrObjectDiagram, ...)
    ' return CommandExecutionResult
    ' return CommandExecutionResult
    return
    return
    return
  end  
  return Diagram

end
return Diagram

return AbstractPSystem

": SourceFileReaderAbstract" -> PSystemUtils : exportDiagrams
PSystemUtils -> ": AbstractPSystem" : exportDiagram
": AbstractPSystem" -> ": AbstractPSystem" #FFBBBB : exportDiagramNow
": AbstractPSystem" -> ": AbstractPSystem" #DarkSalmon : exportDiagramInternal
": AbstractPSystem" -> ": AbstractPSystem" #005500 : getDotStrings
return

": AbstractPSystem" -> ": CucaDiagramFileMaker" : createFile
": CucaDiagramFileMaker" -> ": CucaDiagramFileMaker" : createFileInternal

": CucaDiagramFileMaker" -> ": GraphvizImageBuilder" : buildImage
return TextBlock

": CucaDiagramFileMaker" -> ": AbstractPSystem" : createImageBuilder

return ImageBuilder

": CucaDiagramFileMaker" -> ": ImageBuilder" : write

": ImageBuilder" -> ": ImageBuilder" : writeImageInternal

return ImageData
return ImageData
return ImageData
return ImageData
return ImageData
return ImageData
return ImageData

return List<FileImageData>
return List<GeneratedImage>
return
return
return

@enduml